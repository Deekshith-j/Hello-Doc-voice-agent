# PostgreSQL connection strings
# Runtime pooler (Supabase transaction pooler on port 6543)
DATABASE_URL=postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres

# Direct connection for migrations (Supabase direct on port 5432)
DIRECT_URL=postgresql://postgres:[password]@db.[project-ref].supabase.co:5432/postgres

# Isolated test database URL for evals and test suite (resets/reseeds safely)
TEST_DATABASE_URL=postgresql://postgres:[password]@localhost:5432/test_db

# Retell AI (optional for initial setup; required for live voice calls)
RETELL_API_KEY=
RETELL_AGENT_ID=
RETELL_LLM_ID=
RETELL_LLM_MODEL=gpt-4.1
RETELL_VOICE_ID=retell-Cimo

# LLM API key for evals and custom prompts (e.g. OpenAI / Anthropic)
LLM_API_KEY=

# Clinic settings
CLINIC_NAME=Docto Family Clinic
CLINIC_TIMEZONE=America/New_York

# Dashboard auth
DASHBOARD_PASSWORD=replace-with-a-long-passphrase
SESSION_SECRET=replace-with-at-least-32-random-characters

# Base URL for webhooks and tools
PUBLIC_BASE_URL=https://your-app.vercel.app

# Google Calendar credentials (optional)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=

# Cron authorization token
CRON_SECRET=
